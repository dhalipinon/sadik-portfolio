# The site's canonical URL, no trailing slash. Used for metadata, JSON-LD,
# sitemap.xml and robots.txt. Defaults to the #1 domain candidate from the
# build plan if unset — update once the real domain is purchased.
NEXT_PUBLIC_SITE_URL=https://sadikpinon.com

# Resend (https://resend.com) — used by src/app/api/contact/route.ts to send
# a real email when someone submits the contact form. Sign up, verify a
# sending domain (or use the resend.dev sandbox address while the custom
# domain isn't live yet), and paste the API key below.
RESEND_API_KEY=

# Where contact-form submissions get delivered.
CONTACT_TO_EMAIL=sadikpinon609@gmail.com

# Must be a verified sender on the Resend account above. Start with the
# Resend sandbox address; switch to something like hello@sadikpinon.dev once
# the custom domain is connected and verified in Resend.
CONTACT_FROM_EMAIL=onboarding@resend.dev
